              ],
              "path": [
                "reservations",
                "{{secondReservationId}}",
                "confirm"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Reservation is CONFIRMED', () => pm.expect(pm.response.json().status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm again -> 200 (idempotent)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{secondReservationId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{secondReservationId}}",
                "confirm"
              ]
            },
            "description": "Simulates a client retry or a duplicate payment webhook: same answer, sold only once."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Reservation is CONFIRMED', () => pm.expect(pm.response.json().status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel a confirmed purchase -> 409",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{secondReservationId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{secondReservationId}}",
                "cancel"
              ]
            },
            "description": "Confirmed purchases cannot be reversed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Error code is INVALID_RESERVATION_STATE', () => pm.expect(pm.response.json().code).to.eql('INVALID_RESERVATION_STATE'));"
                ]
