          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel reservation -> 200 (stock released)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{reservationId}}",
                "cancel"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Reservation is CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel again -> 200 (idempotent)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{reservationId}}",
                "cancel"
              ]
            },
            "description": "Retries are safe: repeating a cancel returns the same result and releases stock only once."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Reservation is CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "User B reserves the released item -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
